# --- Сервер / БД ---
PORT=8082
DB_PATH=./data/app.db

# --- Рекомендации / VIN ---
# LLM_MODE=live: интервалы только из найденных отзывов и страниц. Без live список пуст.
# VIN_MODE=live: Drom, затем NHTSA. VIN_FIXTURE_FALLBACK=1 добавляет фикстуру после них.
VIN_MODE=live
VIN_FIXTURE_FALLBACK=1
LLM_MODE=live
MAINTENANCE_RULES_PATH=data/maintenance_rules.yaml
SEARXNG_BASE_URL=http://127.0.0.1:18081
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:0.5b помещается на немецкий VPS 1.9 ГиБ (ADR-003). 1.5b — только если под Ollama есть отдельные 2 ГБ.
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_KEEP_ALIVE=30s

# --- auth: подпись JWT; без него auth-эндпоинты 503 ---
JWT_SECRET=change-me
# Локальный гараж без мессенджера. На сервере не задавать.
# SERVYS_DEV_LOGIN=1
# Вход и вебхуки мессенджеров. Пустой токен выключает свой вход и вебхук (404).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MINI_APP_URL=
UPLOAD_DIR=./data/uploads
