# --- Сервер / БД ---
PORT=8082
DB_PATH=./data/app.db

# --- Рекомендации / VIN ---
# LLM_MODE=live: интервалы только из найденных отзывов и страниц. Без live список пуст.
# VIN_MODE=live: Drom, затем NHTSA. VIN_FIXTURE_FALLBACK=1 добавляет фикстуру после них.
VIN_MODE=live
VIN_FIXTURE_FALLBACK=1
LLM_MODE=live
MAINTENANCE_RULES_PATH=data/maintenance_rules.yaml
SEARXNG_BASE_URL=http://127.0.0.1:18081
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Поиск страниц — bonsai-2:27b. Текст страницы читает qwen3.5:9b (ADR-006).
# На хосте обе сразу не держат: запас 15 ГБ. Поиск выгружается, затем читается текст.
OLLAMA_SEARCH_MODEL=bonsai-2:27b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=70m
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=30s
# Сохранённый разбор показывается 7 дней. Старше недели считается заново в фоне, экран до этого показывает прежний список.
# RECO_REFRESH=168h

# --- auth: подпись JWT; без него auth-эндпоинты 503 ---
JWT_SECRET=change-me
# Локальный гараж без мессенджера. На сервере не задавать.
# SERVYS_DEV_LOGIN=1
# Вход и вебхуки мессенджеров. Пустой токен выключает свой вход и вебхук (404).
TELEGRAM_BOT_TOKEN=
# Числовой id. Этот человек при входе из Telegram видит список пользователей.
TELEGRAM_ADMIN_ID=
TELEGRAM_WEBHOOK_SECRET=
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MINI_APP_URL=
UPLOAD_DIR=./data/uploads
